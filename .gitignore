node_modules/
dist/

# Biến môi trường cục bộ — .env.local đè lên .env khi chạy Vite.
# Dùng file này để trỏ vào Supabase project TEST, tránh ghi vào dữ liệu lớp học thật.
.env.local
.env.*.local

# Secret của Edge Function (ANTHROPIC_API_KEY…). KHÔNG bao giờ commit.
#
# `.env` ở gốc thì ĐANG được theo dõi, và đúng như vậy: nó chỉ chứa
# VITE_SUPABASE_URL và VITE_SUPABASE_ANON_KEY — hai thứ vốn nằm sẵn trong
# bundle gửi xuống trình duyệt, không phải bí mật.
#
# supabase/.env thì khác hẳn: nó chứa khoá thật, loại tiêu được tiền. Che ở
# đây TRƯỚC khi có ai tạo file đó, vì thêm dòng này sau khi lỡ commit thì đã
# muộn — khoá nằm trong lịch sử git và phải thu hồi bên Anthropic.
supabase/.env

# Scratch của quy trình subagent-driven development
.superpowers/

# CLI link state
supabase/.temp/

# Bản sao lưu do scripts/strip-account-passwords.mjs tạo ra. Nó chứa mật khẩu
# học sinh dạng thô — đúng thứ script đó sinh ra để xoá khỏi database, nên
# tuyệt đối không được đẩy lên remote.
*.backup.json
